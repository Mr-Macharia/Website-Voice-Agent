# ===========================================================================
# Project Environment Configuration (.env)
#
# Loaded from backend/.env, then the repo root .env, then the real
# environment. A variable set by the host always wins — which is what a
# deployment needs. See backend/core/config.py.
# ===========================================================================

# --- Voice: AssemblyAI Voice Agent API (required for voice) ----------------
# One WebSocket carrying STT, turn detection and TTS. The browser never sees
# this key: it calls /api/voice/token, which mints a short-lived token.
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here
# The stored agent, from: uv run python scripts/provision_agent.py
# A stored agent is required, not optional: the API rejects a custom `llm` on
# session.update, so keeping our own model means storing the agent. The
# persona, voice and tools live on it too, so re-run with --update after
# editing core/persona.py or the change never reaches a call.
ASSEMBLYAI_AGENT_ID=agent_...
# Exact voice id — an invented one is rejected at session.update.
# US: alba eve george jane jean mary michael | UK: anna charles paul vera
ASSEMBLYAI_VOICE=anna
# near-field for headsets and laptop mics; far-field for rooms. This is what
# suppresses a TV or background chatter before it reaches transcription.
ASSEMBLYAI_VOICE_FOCUS=near-field
# min_latency | balanced | max_accuracy
ASSEMBLYAI_TRANSCRIPTION_MODE=balanced
# How long the visitor must speak before cutting the agent off, in ms (0-1000).
# The API default is 500 on balanced, which feels sluggish. Raise it if the
# agent interrupts itself or short back-channels cut it off.
ASSEMBLYAI_INTERRUPTION_DELAY=100

# --- Voice: LLM proxy ------------------------------------------------------
# AssemblyAI accepts exactly one LLM endpoint and calls it server-to-server,
# so this must be public HTTPS — localhost is rejected. Local development
# points at the deployed instance. The proxy is what keeps the Bedrock/xAI/
# OpenAI fallback chain alive behind that single URL.
LLM_PROXY_URL=https://your-app.herokuapp.com/api/llm
# Shared secret, sent as the llm[].api_key and checked on arrival so the
# public endpoint isn't open to whoever finds it. Any long random string.
LLM_PROXY_SECRET=generate-a-long-random-string

# --- LLM Providers (at least one required) ---------------------------------
# Tried in this order by the proxy: Bedrock, then OpenAI, then xAI.
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_API_KEY=your-bedrock-api-key-here
BEDROCK_MODEL_ID=deepseek.v3.2
OPENAI_API_KEY=sk-your-key-here
XAI_API_KEY=xai-your-key-here

# --- Database (Postgres + pgvector) ----------------------------------------
# Needed for the knowledge base and lead capture. Voice still works without
# it; those two tools are simply not offered.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Embeddings (DeepInfra, OpenAI-compatible) -----------------------------
DEEPINFRA_API_KEY=your-deepinfra-key-here
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# EMBED_DIMENSIONS must match EMBED_MODEL, or pgvector gets a mis-sized column.
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIMENSIONS=768

# --- Cal.com booking -------------------------------------------------------
CALCOM_BOOKING_URL=https://cal.com/your-handle/your-event

# --- Composio / Gmail (optional) -------------------------------------------
COMPOSIO_API_KEY=your-composio-key-here
COMPOSIO_USER_ID=gichogu-site-agent
# notify (drafts only) | read | full. A security control, not a convenience:
# the agent is public-facing. See backend/core/tools/gmail.py.
GMAIL_SCOPE=notify

# --- Lead notification (optional) ------------------------------------------
LEAD_NOTIFY_EMAIL=you@example.com
LEAD_SMTP_HOST=smtp.gmail.com
LEAD_SMTP_PORT=587
LEAD_SMTP_USER=you@example.com
LEAD_SMTP_APP_PASSWORD=your-app-password

# --- Owner identity --------------------------------------------------------
OWNER_NAME=Gichogu Macharia
GITHUB_USERNAME=Mr-Macharia
# NOTE: the apex gichogumacharia.tech has no DNS record; only www resolves.
SITE_URL=https://www.gichogumacharia.tech

# --- Deepgram (legacy) -----------------------------------------------------
# Only still used by the batch /api/stt endpoint. The voice path no longer
# needs it; remove once that endpoint goes.
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# --- LiveKit (legacy, being removed) ---------------------------------------
# Only needed to run the old voice path with NEXT_PUBLIC_VOICE_PROVIDER=livekit.
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret01234567890123456789012345678901
